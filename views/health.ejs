    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/js/script.js"></script>
    <script>
    $(document).ready(function() {
        // Mostrar/ocultar fechas personalizadas para reportes
        $('#report_period').change(function() {
            if ($(this).val() === 'custom') {
                $('#customDates').show();
            } else {
                $('#customDates').hide();
            }
        });

        // Generar Reporte
        $('#generateReportForm').submit(function(e) {
            e.preventDefault();
            
            const formData = $(this).serialize();
        
            
            // Descargar reporte
            const url = '/health/generate-report?' + formData;
            window.open(url, '_blank');
            
            $('#generateReportModal').modal('hide');
        });

        // Cargar animales según tipo seleccionado
        $('#animal_type').change(function() {
            const animalType = $(this).val();
            if (animalType) {
                $.ajax({
                    url: '/health/get-animals',
                    method: 'POST',
                    data: { animal_type: animalType },
                    success: function(response) {
                        $('#animal_id').empty().append('<option value="">Seleccionar animal</option>');
                        response.forEach(function(animal) {
                            $('#animal_id').append(`<option value="${animal.id}">${animal.name} (${animal.breed})</option>`);
                        });
                    }
                });
            }
        });

        // Nueva Vacunación
        $('#newVaccinationForm').submit(function(e) {
            e.preventDefault();
            
            $.ajax({
                url: '/health/add-vaccination',
                method: 'POST',
                data: $(this).serialize(),
                success: function(response) {
                    if (response.success) {
                        alert('Vacunación registrada correctamente');
                        location.reload();
                    } else {
                        alert('Error: ' + response.error);
                    }
                },
                error: function() {
                    alert('Error al registrar la vacunación');
                }
            });
        });

        $('.edit-vaccination').click(function() {
            const id = $(this).data('id');
            const row = $(this).closest('tr');
            
            $('#edit_vaccination_id').val(id);
            $('#edit_vaccine').val(row.find('td:nth-child(3)').text());
            $('#edit_date').val(row.find('td:nth-child(4)').text());
            $('#edit_status').val(row.find('.badge').text().trim());
            $('#edit_treatment').val(row.find('td:nth-child(5)').text());
            $('#edit_dosage').val(row.find('td:nth-child(6)').text());
            $('#edit_start_date').val(row.find('td:nth-child(7)').text());
            $('#edit_end_date').val(row.find('td:nth-child(8)').text());
            $('#edit_observations').val(row.find('td:nth-child(9)').text());
        });

        $('#editVaccinationForm').submit(function(e) {
            e.preventDefault();
            
            $.ajax({
                url: '/health/update-vaccination/' + $('#edit_vaccination_id').val(),
                method: 'PUT',
                data: $(this).serialize(),
                success: function(response) {
                    if (response.success) {
                        alert('Vacunación actualizada correctamente');
                        location.reload();
                    }
                },
                error: function() {
                    alert('Error al actualizar la vacunación');
                }
            });
        });

        // Agregar Tratamiento
        $('.add-treatment').click(function() {
            $('#treatment_vaccination_id').val($(this).data('id'));
        });

        $('#addTreatmentForm').submit(function(e) {
            e.preventDefault();
            
            $.ajax({
                url: '/health/add-treatment',
                method: 'POST',
                data: $(this).serialize(),
                success: function(response) {
                    if (response.success) {
                        alert('Tratamiento agregado correctamente');
                        location.reload();
                    }
                },
                error: function() {
                    alert('Error al agregar el tratamiento');
                }
            });
        });

        // Nueva Actividad
        $('#newActivityForm').submit(function(e) {
            e.preventDefault();
            
            $.ajax({
                url: '/health/add-activity',
                method: 'POST',
                data: $(this).serialize(),
                success: function(response) {
                    if (response.success) {
                        alert('Actividad programada correctamente');
                        location.reload();
                    }
                },
                error: function() {
                    alert('Error al programar la actividad');
                }
            });
        });
    });
    // Eliminar Vacunación
$('.delete-vaccination').click(function(e) {
    e.preventDefault();
    
    const id = $(this).data('id');
    const animalName = $(this).data('name');
    const vaccine = $(this).data('vaccine');
    
    if (confirm(`¿Está seguro de eliminar la vacunación de "${vaccine}" para el animal "${animalName}"? Esta acción no se puede deshacer.`)) {
        $.ajax({
            url: '/health/delete-vaccination/' + id,
            method: 'DELETE',
            success: function(response) {
                if (response.success) {
                    alert('Vacunación eliminada correctamente');
                    // Remover la fila de la tabla
                    $('#vaccination-' + id).remove();
                    
                    // Si no quedan filas, mostrar mensaje
                    if ($('#vaccinationsTable tr').length === 1) { // Solo queda el encabezado
                        $('#vaccinationsTable').append('<tr><td colspan="6" class="text-center">No hay vacunaciones registradas</td></tr>');
                    }
                } else {
                    alert('Error: ' + response.error);
                }
            },
            error: function(xhr, status, error) {
                alert('Error al eliminar la vacunación: ' + (xhr.responseJSON?.error || 'Error desconocido'));
            }
        });
    }
});
    </script>
</body>
</html>