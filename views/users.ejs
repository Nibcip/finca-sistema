<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GanaSys - Usuarios y Roles</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .avatar-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: white;
        }
        .bg-primary { background-color: #4e73df; }
        .bg-success { background-color: #1cc88a; }
        .bg-warning { background-color: #f6c23e; }
        .bg-info { background-color: #36b9cc; }
        .bg-secondary { background-color: #858796; }
        .bg-danger { background-color: #e74a3b; }
        .bg-dark { background-color: #5a5c69; }
        .status-badge {
            cursor: pointer;
            transition: all 0.3s;
        }
        .status-badge:hover {
            opacity: 0.8;
            transform: scale(1.05); 
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <a class="sidebar-brand d-flex align-items-center justify-content-center" href="/dashboard">
            <div class="sidebar-brand-icon">
                <i class="fas fa-cow"></i>
            </div>
            <div class="sidebar-brand-text mx-3">GanaSys</div>
        </a>
        <hr class="sidebar-divider my-0">
    <ul class="nav flex-column">
    <li class="nav-item">
        <a class="nav-link" href="/dashboard">
            <i class="fas fa-fw fa-tachometer-alt"></i>
            <span>Inicio</span>
        </a>
    </li>
    <% if (user.role == 'admin' || user.role == 'supervisor' || user.role == "operador") { %>
    <li class="nav-item">
        <a class="nav-link" href="/users">
            <i class="fas fa-fw fa-users"></i>
            <span>Usuarios</span>
        </a>
    </li>
    <% } %>
    <li class="nav-item">
        <a class="nav-link" href="/livestock">
            <i class="fas fa-fw fa-cow"></i>
            <span>Ganado y Porcinos</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/reproduction">
            <i class="fas fa-fw fa-heart"></i>
            <span>Reproducción</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/health">
            <i class="fas fa-fw fa-syringe"></i>
            <span>Vacunación y Sanidad</span>
        </a>
    </li>
    <% if (user.role == 'admin' || user.role == 'supervisor') { %>
    <li class="nav-item">
        <a class="nav-link" href="/sales">
            <i class="fas fa-fw fa-dollar-sign"></i>
            <span>Ventas</span>
        </a>
    </li>
    <% } %>
    <% if (user.role == 'admin' || user.role == 'supervisor' || user.role == "operador") { %>
    <!-- INVENTARIO DEBE IR AQUÍ (después de Ventas) -->
    <li class="nav-item">
        <a class="nav-link" href="/inventory">
            <i class="fas fa-fw fa-warehouse"></i>
            <span>Inventario</span>
        </a>
    </li>
    <% } %>
    <!-- FIN DEL INVENTARIO -->
    <li class="nav-item">
        <a class="nav-link" href="/logout">
            <i class="fas fa-fw fa-sign-out-alt"></i>
            <span>Cerrar Sesión</span>
        </a>
    </li>
</ul>
    </div>

    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                <button id="sidebarToggle" class="btn btn-link d-md-none rounded-circle mr-3">
                    <i class="fa fa-bars"></i>
                </button>
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item dropdown no-arrow">
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="container-fluid">
                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                    <h1 class="h3 mb-0 text-gray-800">Gestión de Usuarios y Roles</h1>
                    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
                        <i class="fas fa-plus fa-sm"></i> Nuevo Usuario
                    </button>
                </div>

                <% if (error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div class="row">
                    <div class="col-xl-8">
                        <div class="card shadow mb-4">
                            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                                <h6 class="m-0 font-weight-bold text-primary">Lista de Usuarios</h6>
                                <span class="badge bg-primary">Total: <%= users.length %> usuarios</span>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                                        <thead class="thead-light">
                                            <tr>
                                                <th>Usuario</th>
                                                <th>Rol</th>
                                                <th>Estado</th>
                                                <th>Último Acceso</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% users.forEach(user => { %>
                                            <!-- 🆕 DATA ATTRIBUTE AGREGADO: data-user-id en la fila -->
                                            <tr data-user-id="<%= user.id %>">
                                                <!-- 🆕 DATA ATTRIBUTE AGREGADO: data-user-name en la celda del nombre -->
                                                <td data-user-name="<%= user.name %>">
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar-circle bg-primary">
                                                            <%= user.name.charAt(0).toUpperCase() %>
                                                        </div>
                                                        <div class="ms-3">
                                                            <div class="text-primary font-weight-bold"><%= user.name %></div>
                                                            <div class="text-muted small"><%= user.email %></div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-<%= 
                                                        user.role === 'admin' ? 'danger' :
                                                        user.role === 'veterinario' ? 'warning' :
                                                        user.role === 'supervisor' ? 'info' : 'secondary'
                                                    %>">
                                                        <i class="fas fa-<%= 
                                                            user.role === 'admin' ? 'user-shield' :
                                                            user.role === 'veterinario' ? 'syringe' :
                                                            user.role === 'supervisor' ? 'clipboard-check' : 'user'
                                                        %> me-1"></i>
                                                        <%= user.role %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <!-- 🆕 NUEVO: Badge de estado interactivo -->
                                                    <span class="badge status-badge bg-<%= 
                                                        user.status === 'activo' ? 'success' :
                                                        user.status === 'inactivo' ? 'danger' :
                                                        user.status === 'reposo' ? 'warning' : 'dark'
                                                    %>" 
                                                    data-user-id="<%= user.id %>"
                                                    data-current-status="<%= user.status %>"
                                                    onclick="changeUserStatus(<%= user.id %>, '<%= user.name %>', '<%= user.status %>')">
                                                        <i class="fas fa-<%= 
                                                            user.status === 'activo' ? 'check-circle' :
                                                            user.status === 'inactivo' ? 'times-circle' :
                                                            user.status === 'reposo' ? 'moon' : 'question-circle'
                                                        %> me-1"></i>
                                                        <%= user.status.charAt(0).toUpperCase() + user.status.slice(1) %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="text-muted small">
                                                        <%= new Date(user.last_access).toLocaleDateString('es-ES', {
                                                            year: 'numeric',
                                                            month: 'short',
                                                            day: 'numeric',
                                                            hour: '2-digit',
                                                            minute: '2-digit'
                                                        }) %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="btn-group">
                                                        <button class="btn btn-sm btn-outline-primary btn-edit" 
                                                                data-user-id="<%= user.id %>" 
                                                                title="Editar">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <!-- 🆕 ESTOS BOTONES AHORA FUNCIONARÁN CON EL JavaScript -->
                                                        <button class="btn btn-sm btn-outline-danger ml-1 btn-delete" 
                                                                data-user-id="<%= user.id %>" 
                                                                data-user-name="<%= user.name %>"
                                                                title="Eliminar">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4">
                        <div class="card shadow mb-4">
                            <div class="card-header py-3">
                                <h6 class="m-0 font-weight-bold text-primary">Roles y Permisos</h6>
                            </div>
                            <div class="card-body">
                                <div class="mb-4 p-3 border-start border-4 border-primary bg-light rounded">
                                    <h6 class="font-weight-bold text-primary mb-3">
                                        <i class="fas fa-user-shield me-2"></i>Administrador
                                    </h6>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small text-muted">
                                            <i class="fas fa-users me-1"></i>
                                            <%= users.filter(u => u.role === 'admin').length %> usuario(s)
                                        </span>
                                        <span class="badge bg-primary">Todos los permisos</span>
                                    </div>
                                    <ul class="list-unstyled small text-muted mb-0">
                                        <li><i class="fas fa-check text-success me-1"></i>Gestión completa del sistema</li>
                                        <li><i class="fas fa-check text-success me-1"></i>Administración de usuarios</li>
                                        <li><i class="fas fa-check text-success me-1"></i>Configuración del sistema</li>
                                    </ul>
                                </div>

                                <div class="mb-4 p-3 border-start border-4 border-warning bg-light rounded">
                                    <h6 class="font-weight-bold text-warning mb-3">
                                        <i class="fas fa-syringe me-2"></i>Veterinario
                                    </h6>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small text-muted">
                                            <i class="fas fa-users me-1"></i>
                                            <%= users.filter(u => u.role === 'veterinario').length %> usuario(s)
                                        </span>
                                        <span class="badge bg-warning">Permisos específicos</span>
                                    </div>
                                    <ul class="list-unstyled small text-muted mb-0">
                                        <li><i class="fas fa-check text-success me-1"></i>Gestión de sanidad animal</li>
                                        <li><i class="fas fa-check text-success me-1"></i>Registro de vacunaciones</li>
                                        <li><i class="fas fa-check text-success me-1"></i>Control de reproducción</li>
                                    </ul>
                                </div>

                                <div class="mb-4 p-3 border-start border-4 border-info bg-light rounded">
                                    <h6 class="font-weight-bold text-info mb-3">
                                        <i class="fas fa-clipboard-check me-2"></i>Supervisor
                                    </h6>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small text-muted">
                                            <i class="fas fa-users me-1"></i>
                                            <%= users.filter(u => u.role === 'supervisor').length %> usuario(s)
                                        </span>
                                        <span class="badge bg-info">Todos los permisos</span>
                                    </div>
                                    <ul class="list-unstyled small text-muted mb-0">
                                        <li><i class="fas fa-check text-success me-1"></i>Gestión completa del sistema</li>
                                        <li><i class="fas fa-check text-success me-1"></i>Administración de usuarios</li>
                                        <li><i class="fas fa-check text-success me-1"></i>Configuración del sistema</li>
                                    </ul>
                                </div>

                                <div class="mb-4 p-3 border-start border-4 border-secondary bg-light rounded">
                                    <h6 class="font-weight-bold text-secondary mb-3">
                                        <i class="fas fa-user me-2"></i>Operador
                                    </h6>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small text-muted">
                                            <i class="fas fa-users me-1"></i>
                                            <%= users.filter(u => u.role === 'operador').length %> usuario(s)
                                        </span>
                                        <span class="badge bg-secondary">Permisos Moderados</span>
                                    </div>
                                    <ul class="list-unstyled small text-muted mb-0">
                                        <li><i class="fas fa-check text-success me-1"></i>Registros de ganado y porcinos</li>
                                        <li><i class="fas fa-check text-success me-1"></i>Módulo de Reproducción y Vacunación</li>
                                        <li><i class="fas fa-check text-success me-1"></i>Control de Inventario</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="card shadow">
                            <div class="card-header py-3">
                                <h6 class="m-0 font-weight-bold text-primary">Estadísticas de Usuarios</h6>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-6 mb-3">
                                        <div class="text-primary">
                                            <i class="fas fa-users fa-2x mb-2"></i>
                                            <h4><%= users.length %></h4>
                                            <small class="text-muted">Total Usuarios</small>
                                        </div>
                                    </div>
                                    <div class="col-6 mb-3">
                                        <div class="text-success">
                                            <i class="fas fa-user-check fa-2x mb-2"></i>
                                            <h4><%= users.filter(u => u.status === 'activo').length %></h4>
                                            <small class="text-muted">Usuarios Activos</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="progress mb-3" style="height: 20px;">
                                    <div class="progress-bar bg-primary" style="width: 25%">Admin</div>
                                    <div class="progress-bar bg-warning" style="width: 25%">Vet</div>
                                    <div class="progress-bar bg-info" style="width: 25%">Super</div>
                                    <div class="progress-bar bg-secondary" style="width: 25%">Oper</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<!-- Modal para agregar usuario (EXISTENTE) -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-user-plus me-2"></i>Agregar Nuevo Usuario
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addUserForm">
                    <div class="mb-3">
                        <label class="form-label">Nombre completo *</label>
                        <input type="text" class="form-control" name="name" required 
                               placeholder="Ej: Juan Pérez García">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Correo electrónico *</label>
                        <input type="email" class="form-control" name="email" required 
                               placeholder="Ej: juan.perez@ganasys.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contraseña *</label>
                        <input type="password" class="form-control" name="password" required 
                               placeholder="Mínimo 6 caracteres" minlength="6">
                        <div id="passwordFeedback" class="form-text"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Rol *</label>
                        <select class="form-select" name="role" required>
                            <option value="">Seleccionar rol...</option>
                            <option value="admin">
                                👑 Administrador - Acceso completo al sistema
                            </option>
                            <option value="veterinario">
                                💉 Veterinario - Gestión de sanidad y vacunación
                            </option>
                            <option value="supervisor">
                                👁️ Supervisor - Control y supervisión
                            </option>
                            <option value="operador">
                                🔧 Operador - Registros básicos
                            </option>
                        </select>
                    </div>
                    <!-- 🆕 NUEVO: Campo de estado para nuevo usuario -->
                    <div class="mb-3">
                        <label class="form-label">Estado del Usuario *</label>
                        <select class="form-select" name="status" required>
                            <option value="activo" selected>✅ Activo - Puede acceder al sistema</option>
                            <option value="inactivo">❌ Inactivo - No puede acceder al sistema</option>
                            <option value="reposo">⏸️ Reposo - Acceso temporalmente suspendido</option>
                        </select>
                        <div class="form-text">
                            <small>
                                <i class="fas fa-info-circle"></i> 
                                <strong>Activo:</strong> Acceso completo. 
                                <strong>Inactivo:</strong> Sin acceso. 
                                <strong>Reposo:</strong> Acceso temporal suspendido.
                            </small>
                        </div>
                    </div>
                    <div class="alert alert-info">
                        <small>
                            <i class="fas fa-info-circle me-1"></i>
                            El usuario recibirá un email con sus credenciales de acceso.
                        </small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <button type="submit" id="btnGuardarNuevoUsuario" form="addUserForm" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Crear Usuario
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 🆕 MODAL PARA EDITAR USUARIO -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-user-edit me-2"></i>Editar Usuario
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editUserForm">
                    <input type="hidden" id="editUserId" name="id">
                    <div class="mb-3">
                        <label class="form-label">Nombre completo *</label>
                        <input type="text" class="form-control" id="editUserName" name="name" required 
                               placeholder="Ej: Juan Pérez García">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Correo electrónico *</label>
                        <input type="email" class="form-control" id="editUserEmail" name="email" required 
                               placeholder="Ej: juan.perez@ganasys.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contraseña (dejar en blanco para no cambiar)</label>
                        <input type="password" class="form-control" id="editUserPassword" name="password" 
                               placeholder="Mínimo 6 caracteres" minlength="6">
                        <div class="form-text">Si no deseas cambiar la contraseña, deja este campo vacío.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Rol *</label>
                        <select class="form-select" id="editUserRole" name="role" required>
                            <option value="">Seleccionar rol...</option>
                            <option value="admin">
                                👑 Administrador - Acceso completo al sistema
                            </option>
                            <option value="veterinario">
                                💉 Veterinario - Gestión de sanidad y vacunación
                            </option>
                            <option value="supervisor">
                                👁️ Supervisor - Acceso completo al sistema
                            </option>
                            <option value="operador">
                                🔧 Operador - Registros y Control
                            </option>
                        </select>
                    </div>
                    <!-- 🆕 NUEVO: Campo de estado para editar usuario -->
                    <div class="mb-3">
                        <label class="form-label">Estado del Usuario *</label>
                        <select class="form-select" id="editUserStatus" name="status" required>
                            <option value="activo">✅ Activo - Puede acceder al sistema</option>
                            <option value="inactivo">❌ Inactivo - No puede acceder al sistema</option>
                            <option value="reposo">⏸️ Reposo - Acceso temporalmente suspendido</option>
                        </select>
                        <div class="form-text">
                            <small>
                                <i class="fas fa-exclamation-triangle"></i> 
                                Usuarios en estado <strong>Inactivo</strong> o <strong>Reposo</strong> no podrán iniciar sesión.
                            </small>
                        </div>
                    </div>
                    <div class="alert alert-warning">
                        <small>
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Los cambios se aplicarán inmediatamente.
                        </small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <button type="submit" form="editUserForm" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 🆕 MODAL PARA CAMBIAR ESTADO RÁPIDO -->
<div class="modal fade" id="changeStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exchange-alt me-2"></i>Cambiar Estado
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-center mb-3">Selecciona el nuevo estado para:</p>
                <h6 class="text-center mb-4" id="statusUserName"></h6>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-success" onclick="confirmStatusChange('activo')">
                        <i class="fas fa-check-circle me-2"></i>Activo
                    </button>
                    <button type="button" class="btn btn-warning" onclick="confirmStatusChange('reposo')">
                        <i class="fas fa-moon me-2"></i>Reposo
                    </button>
                    <button type="button" class="btn btn-danger" onclick="confirmStatusChange('inactivo')">
                        <i class="fas fa-times-circle me-2"></i>Inactivo
                    </button>
                </div>
                <div class="mt-3 alert alert-info">
                    <small>
                        <i class="fas fa-info-circle"></i> 
                        Solo usuarios con estado <strong>Activo</strong> pueden iniciar sesión.
                    </small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
        // --- LOGICA PARA EDITAR ---
        const editModal = new bootstrap.Modal(document.getElementById('editUserModal'));
        const backDropModalCancel = document.getElementById('editUserModal');
        // Al hacer clic en el botón azul de editar de la tabla
        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-user-id');
                // Buscamos los datos del usuario al servidor
                fetch('/users/' + id)
                    .then(res => res.json())
                    .then(data => {
                        if(data.success) {
                            document.getElementById('editUserId').value = data.user.id;
                            document.getElementById('editUserName').value = data.user.name;
                            document.getElementById('editUserEmail').value = data.user.email;
                            document.getElementById('editUserRole').value = data.user.role;
                            document.getElementById('editUserStatus').value = data.user.status;
                            editModal.show();
                        }
                    });
            });
        });

        // Al enviar el formulario de edición (Guardar Cambios)
        document.getElementById('editUserForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const id = document.getElementById('editUserId').value;
            const formData = {
                name: document.getElementById('editUserName').value,
                email: document.getElementById('editUserEmail').value,
                role: document.getElementById('editUserRole').value,
                status: document.getElementById('editUserStatus').value,
                password: document.getElementById('editUserPassword').value
            };

            fetch('/users/' + id, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    alert('Usuario actualizado');
                    location.reload();
                } else {
                    alert('Error: ' + data.error);
                }
            });
        });

        // Función para cerrar el modal de edición
        backDropModalCancel.addEventListener('hidden.bs.modal', function (event) {
                const backdrops = document.querySelectorAll('.modal-backdrop');
                backdrops.forEach(backdrop => backdrop.remove());
                document.body.classList.remove('modal-open')
                document.body.style.overflow = '';
                document.body.style.paddingRight = '';

            });

        // --- LOGICA PARA ELIMINAR ---
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-user-id');
                const name = this.getAttribute('data-user-name');
                if(confirm('¿Estás segura de eliminar a ' + name + '?')) {
                    fetch('/users/' + id, { method: 'DELETE' })
                        .then(res => res.json())
                        .then(data => {
                            if(data.success) { location.reload(); }
                        });
                }
            });
        });
    });

    // Variables globales para el cambio de estado
    let currentUserId = null;
    let currentUserName = null;
    let currentUserStatus = null;

    // Función para abrir el modal de cambio de estado
    function changeUserStatus(userId, userName, currentStatus) {
        currentUserId = userId;
        currentUserName = userName;
        currentUserStatus = currentStatus;
        
        document.getElementById('statusUserName').textContent = userName;
        
        // Remover clases activas de todos los botones
        document.querySelectorAll('#changeStatusModal .btn').forEach(btn => {
            btn.classList.remove('active');
        });
        
        // Marcar el estado actual como activo
        const currentStatusBtn = document.querySelector(`#changeStatusModal .btn[onclick*="${currentStatus}"]`);
        if (currentStatusBtn) {
            currentStatusBtn.classList.add('active');
            currentStatusBtn.innerHTML = `<i class="fas fa-check me-2"></i>${currentStatusBtn.textContent} (Actual)`;
        }
        
        const modal = new bootstrap.Modal(document.getElementById('changeStatusModal'));
        modal.show();
    }

    // Función para confirmar el cambio de estado
    function confirmStatusChange(newStatus) {
        if (!currentUserId) return;
        
        fetch(`/users/${currentUserId}/status`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ status: newStatus })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Actualizar el badge en la tabla
                const badge = document.querySelector(`[data-user-id="${currentUserId}"] .status-badge`);
                if (badge) {
                    // Cambiar clases según el estado
                    badge.className = 'badge status-badge ';
                    if (newStatus === 'activo') badge.classList.add('bg-success');
                    else if (newStatus === 'inactivo') badge.classList.add('bg-danger');
                    else if (newStatus === 'reposo') badge.classList.add('bg-warning');
                    
                    // Cambiar icono
                    const icon = badge.querySelector('i');
                    if (newStatus === 'activo') icon.className = 'fas fa-check-circle me-1';
                    else if (newStatus === 'inactivo') icon.className = 'fas fa-times-circle me-1';
                    else if (newStatus === 'reposo') icon.className = 'fas fa-moon me-1';
                    
                    // Cambiar texto
                    const textNode = badge.childNodes[badge.childNodes.length - 1];
                    if (textNode.nodeType === Node.TEXT_NODE) {
                        textNode.textContent = newStatus.charAt(0).toUpperCase() + newStatus.slice(1);
                    }
                    
                    // Actualizar data attribute
                    badge.setAttribute('data-current-status', newStatus);
                }
                
                // Cerrar modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('changeStatusModal'));
                modal.hide();
                
                // Mostrar mensaje de éxito
                alert(`✅ Estado cambiado a "${newStatus}" para ${currentUserName}`);
                
                // Recargar la página para actualizar estadísticas
                setTimeout(() => location.reload(), 1000);
            } else {
                alert(`❌ Error: ${data.error}`);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('❌ Error al cambiar el estado');
        });
    }

    // Inicialización cuando se carga la página
    document.addEventListener('DOMContentLoaded', function() {
        // Tu código JavaScript existente aquí...
        // (incluye las funciones para editar, eliminar, etc.)
    });
</script>
<script src="/js/users.js"></script>
</body>
</html>