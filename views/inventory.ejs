<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GanaSys - Inventario de Alimentos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Colores verde manzana */
        :root {
            --apple-green: #00b627;
            --apple-green-dark: #32CD32;
            --apple-green-light: #00cc00;
            --apple-green-very-light: #ffffff;
        }
        
        body {
            background-color: #f8f9fa;
            padding-top: 0 !important;
            margin-top: 0 !important;
        }
        
        .sidebar {
            background-color: #2E7D32 !important;
            color: white;
        }
        
        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.8);
        }
        
        .sidebar .nav-link.active {
            color: white;
            background-color: rgba(255, 255, 255, 0.15);
            border-left: 4px solid var(--apple-green);
        }
        
        .sidebar .nav-link:hover {
            color: white;
            background-color: rgba(255, 255, 255, 0.1);
        }
        
        .card-header {
            background-color: var(--apple-green-very-light) !important;
            border-bottom: 2px solid var(--apple-green-light) !important;
            color: #2E7D32 !important;
        }
        
        .btn-primary {
            background-color: var(--apple-green-dark) !important;
            border-color: var(--apple-green-dark) !important;
        }
        
        .btn-primary:hover {
            background-color: #228B22 !important;
            border-color: #228B22 !important;
        }
        
        .btn-success {
            background-color: var(--apple-green) !important;
            border-color: var(--apple-green) !important;
        }
        
        .btn-success:hover {
            background-color: #32CD32 !important;
            border-color: #32CD32 !important;
        }
        
        .badge-critical {
            background-color: #dc3545 !important;
            color: white !important;
        }
        
        .badge-low {
            background-color: #ffc107 !important;
            color: black !important;
        }
        
        .badge-normal {
            background-color: var(--apple-green-dark) !important;
            color: white !important;
        }
        
        .badge-expired {
            background-color: #6c757d !important;
            color: white !important;
        }
        
        .stock-bar {
            height: 8px;
            border-radius: 4px;
            background-color: #e9ecef;
            overflow: hidden;
            margin-top: 5px;
        }
        
        .stock-fill {
            height: 100%;
            border-radius: 4px;
        }
        
        /* Tarjetas con borde izquierdo verde */
        .value-card {
            border-left: 4px solid #4e73df !important;
        }
        
        .quantity-card {
            border-left: 4px solid var(--apple-green-dark) !important;
        }
        
        .warning-card {
            border-left: 4px solid #ffc107 !important;
        }
        
        .danger-card {
            border-left: 4px solid #dc3545 !important;
        }
        
        /* Ajuste para que la tabla no sea tan alta */
        #content-wrapper {
            min-height: 100vh !important;
        }
        
        #content {
            padding-top: 0 !important;
        }
        
        .container-fluid {
            padding: 20px !important;
        }
        
        /* Ajuste de altura del modal */
        .modal-dialog {
            max-height: 85vh !important;
            margin-top: 5vh !important;
        }
        
        .modal-content {
            max-height: 85vh !important;
            overflow-y: auto !important;
        }
        
        /* Estilos para los botones de acción */
        .btn-outline-primary {
            color: var(--apple-green-dark) !important;
            border-color: var(--apple-green-dark) !important;
        }
        
        .btn-outline-primary:hover {
            background-color: var(--apple-green-dark) !important;
            color: white !important;
        }
        
        .btn-outline-success {
            color: var(--apple-green) !important;
            border-color: var(--apple-green) !important;
        }
        
        .btn-outline-success:hover {
            background-color: var(--apple-green) !important;
            color: white !important;
        }
        
        /* Corrección de espacio */
        .topbar {
            margin-bottom: 0 !important;
            padding: 10px 0 !important;
        }
        
        .page-heading {
            margin-bottom: 20px !important;
        }
        
        /* Scroll suave para tablas largas */
        .table-responsive {
            max-height: 500px !important;
            overflow-y: auto !important;
        }
    </style>
</head>
<body>
    <!-- Sidebar incluido desde parcial -->
    <%- include('partials/sidebar', { currentPage: 'inventory' }) %>

    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">
        <!-- Main Content -->
    <div class="sidebar">
        <a class="sidebar-brand d-flex align-items-center justify-content-center" href="/dashboard">
            <div class="sidebar-brand-icon">
                <i class="fas fa-cow"></i>
            </div>
            <div class="sidebar-brand-text mx-3">GanaSys</div>
        </a>
        <hr class="sidebar-divider my-0">
    <ul class="nav flex-column">
    <li class="nav-item">
        <a class="nav-link" href="/dashboard">
            <i class="fas fa-fw fa-tachometer-alt"></i>
            <span>Inicio</span>
        </a>
    </li>
    <% if (user.role == 'admin' || user.role == 'supervisor' || user.role == "operador") { %>
    <li class="nav-item">
        <a class="nav-link" href="/users">
            <i class="fas fa-fw fa-users"></i>
            <span>Usuarios</span>
        </a>
    </li>
    <% } %>
    <li class="nav-item">
        <a class="nav-link" href="/livestock">
            <i class="fas fa-fw fa-cow"></i>
            <span>Ganado y Porcinos</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/reproduction">
            <i class="fas fa-fw fa-heart"></i>
            <span>Reproducción</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/health">
            <i class="fas fa-fw fa-syringe"></i>
            <span>Vacunación y Sanidad</span>
        </a>
    </li>
    <% if (user.role == 'admin' || user.role == 'supervisor') { %>
    <li class="nav-item">
        <a class="nav-link" href="/sales">
            <i class="fas fa-fw fa-dollar-sign"></i>
            <span>Ventas</span>
        </a>
    </li>
    <% } %>
    <% if (user.role == 'admin' || user.role == 'supervisor' || user.role == "operador") { %>
    <!-- INVENTARIO DEBE IR AQUÍ (después de Ventas) -->
    <li class="nav-item">
        <a class="nav-link" href="/inventory">
            <i class="fas fa-fw fa-warehouse"></i>
            <span>Inventario</span>
        </a>
    </li>
    <% } %>
    <!-- FIN DEL INVENTARIO -->
    <li class="nav-item">
        <a class="nav-link" href="/logout">
            <i class="fas fa-fw fa-sign-out-alt"></i>
            <span>Cerrar Sesión</span>
        </a>
    </li>
</ul>
    </div>

            <!-- Page Content -->
            <div class="container-fluid">
                <!-- Page Heading -->
                <div class="d-sm-flex align-items-center justify-content-between mb-4 page-heading">
                    <h1 class="h3 mb-0 text-gray-800">
                        <i class="fas fa-warehouse me-2" style="color: var(--apple-green-dark);"></i>Inventario de Alimentos
                    </h1>
                    <div class="btn-group">
                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addInventoryModal">
                            <i class="fas fa-plus fa-sm me-1"></i> Nuevo Alimento
                        </button>
                        <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#reportModal">
                            <i class="fas fa-file-pdf fa-sm me-1"></i> Generar Reporte
                        </button>
                        <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#outMovementModal">
                            <i class="fas fa-sign-out-alt fa-sm me-1"></i> Registrar Salida
                        </button>
                    </div>
                </div>

                <!-- Estadísticas -->
                <div class="row mb-4">
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card value-card shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                            Valor Total Inventario
                                        </div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                                            $<%= (stats.total_value || 0).toLocaleString('es-ES', {minimumFractionDigits: 2}) %>
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card quantity-card shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                            Total Items
                                        </div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                                            <%= stats.total_items || 0 %>
                                        </div>
                                        <div class="mt-2 mb-0 text-muted text-xs">
                                            <span class="text-success mr-2"><i class="fas fa-arrow-up"></i> Disponible</span>
                                            <span class="text-nowrap"><%= (stats.total_items || 0) - (stats.out_of_stock || 0) - (stats.low_stock || 0) %> items</span>
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-boxes fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card warning-card shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                            Stock Bajo
                                        </div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                                            <%= stats.low_stock || 0 %>
                                        </div>
                                        <div class="mt-2 mb-0 text-muted text-xs">
                                            <span class="text-warning mr-2"><i class="fas fa-exclamation-triangle"></i> Atención</span>
                                            <span>Reabastecer pronto</span>
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card danger-card shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                            Agotados
                                        </div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                                            <%= stats.out_of_stock || 0 %>
                                        </div>
                                        <div class="mt-2 mb-0 text-muted text-xs">
                                            <span class="text-danger mr-2"><i class="fas fa-times-circle"></i> Urgente</span>
                                            <span>Reabastecer inmediato</span>
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-times-circle fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Distribución por tipo de animal -->
                <div class="row mb-4">
                    <div class="col-lg-4">
                        <div class="card shadow">
                            <div class="card-header py-3">
                                <h6 class="m-0 font-weight-bold text-primary">Valor por Tipo de Animal</h6>
                            </div>
                            <div class="card-body">
                                <canvas id="animalValueChart" width="100%" height="250"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-8">
                        <div class="card shadow">
                            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                                <h6 class="m-0 font-weight-bold text-primary">Movimientos Recientes</h6>
                                <span class="badge bg-primary"><%= movements.length %> movimientos</span>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover">
                                        <thead>
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Alimento</th>
                                                <th>Tipo</th>
                                                <th>Cantidad</th>
                                                <th>Responsable</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (movements && movements.length > 0) { %>
                                                <% movements.forEach(mov => { %>
                                                <tr>
                                                    <td><%= new Date(mov.movement_date).toLocaleDateString() %></td>
                                                    <td><%= mov.food_name %></td>
                                                    <td>
                                                        <span class="badge bg-<%= mov.movement_type === 'entrada' ? 'success' : 'warning' %>">
                                                            <%= mov.movement_type === 'entrada' ? 'ENTRADA' : 'SALIDA' %>
                                                        </span>
                                                    </td>
                                                    <td class="<%= mov.movement_type === 'entrada' ? 'text-success' : 'text-danger' %>">
                                                        <%= mov.movement_type === 'entrada' ? '+' : '-' %><%= mov.quantity %> <%= mov.unit || 'kg' %>
                                                    </td>
                                                    <td><%= mov.responsable %></td>
                                                </tr>
                                                <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted">No hay movimientos registrados</td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabla principal de inventario -->
                <div class="card shadow mb-4">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold text-primary">Inventario de Alimentos</h6>
                        <span class="badge bg-primary"><%= inventory ? inventory.length : 0 %> alimentos registrados</span>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="inventoryTable" width="100%" cellspacing="0">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Alimento</th>
                                        <th>Categoría</th>
                                        <th>Lote</th>
                                        <th>Cantidad</th>
                                        <th>Stock</th>
                                        <th>Precio Unit.</th>
                                        <th>Valor Total</th>
                                        <th>Animal</th>
                                        <th>Vencimiento</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (inventory && inventory.length > 0) { %>
                                        <% inventory.forEach(item => { 
                                            const stockPercentage = item.max_stock > 0 ? (item.quantity / item.max_stock) * 100 : 0;
                                            let stockColor = '#32CD32'; // Verde manzana
                                            if (stockPercentage < 30) stockColor = '#dc3545';
                                            else if (stockPercentage < 60) stockColor = '#ffc107';
                                        %>
                                        <tr>
                                            <td>
                                                <div class="font-weight-bold"><%= item.food_name %></div>
                                                <div class="text-muted small"><%= item.storage_location || 'Sin ubicación' %></div>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">
                                                    <%= item.category ? item.category.toUpperCase() : 'N/A' %>
                                                </span>
                                            </td>
                                            <td><%= item.lot_number || 'N/A' %></td>
                                            <td>
                                                <div class="font-weight-bold"><%= item.quantity ? item.quantity.toLocaleString('es-ES') : 0 %> <%= item.unit || 'kg' %></div>
                                                <div class="stock-bar mt-1">
                                                    <div class="stock-fill" style="width: <%= Math.min(stockPercentage, 100) %>%; background-color: <%= stockColor %>;"></div>
                                                </div>
                                            </td>
                                            <td>
                                                Min: <%= item.min_stock || 0 %> <%= item.unit || 'kg' %><br>
                                                Max: <%= item.max_stock || 0 %> <%= item.unit || 'kg' %>
                                            </td>
                                            <td>$<%= item.unit_price ? item.unit_price.toLocaleString('es-ES', {minimumFractionDigits: 2}) : '0.00' %></td>
                                            <td class="font-weight-bold text-primary">
                                                $<%= item.total_value ? item.total_value.toLocaleString('es-ES', {minimumFractionDigits: 2}) : '0.00' %>
                                            </td>
                                            <td>
                                                <span class="badge bg-<%= 
                                                    item.animal_type === 'ganado' ? 'warning' : 
                                                    item.animal_type === 'porcino' ? 'success' : 'secondary'
                                                %>">
                                                    <%= item.animal_type === 'ganado' ? 'GANADO' : 
                                                       item.animal_type === 'porcino' ? 'PORCINO' : 
                                                       item.animal_type === 'ambos' ? 'AMBOS' : 'N/A' %>
                                                </span>
                                            </td>
                                            <td>
                                                <% if (item.expiration_date) { %>
                                                    <%= new Date(item.expiration_date).toLocaleDateString() %>
                                                    <br>
                                                    <% if (item.days_to_expire !== undefined) { %>
                                                        <small class="text-<%= item.days_to_expire < 0 ? 'danger' : item.days_to_expire < 30 ? 'warning' : 'muted' %>">
                                                            <% if (item.days_to_expire < 0) { %>
                                                                Vencido hace <%= Math.abs(item.days_to_expire) %> días
                                                            <% } else if (item.days_to_expire < 30) { %>
                                                                Vence en <%= item.days_to_expire %> días
                                                            <% } else { %>
                                                                Vence en <%= item.days_to_expire %> días
                                                            <% } %>
                                                        </small>
                                                    <% } %>
                                                <% } else { %>
                                                    <span class="text-muted">No vence</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <span class="badge <%= 
                                                    item.status === 'agotado' || item.status === 'CRITICO' ? 'badge-critical' : 
                                                    item.status === 'bajo_stock' || item.status === 'BAJO' ? 'badge-low' : 
                                                    item.status === 'vencido' ? 'badge-expired' : 'badge-normal'
                                                %>">
                                                    <%= item.status === 'agotado' || item.status === 'CRITICO' ? 'AGOTADO' : 
                                                       item.status === 'bajo_stock' || item.status === 'BAJO' ? 'BAJO STOCK' : 
                                                       item.status === 'vencido' ? 'VENCIDO' : 'DISPONIBLE' %>
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-primary edit-item" 
                                                            data-id="<%= item.id %>" 
                                                            data-item='<%= JSON.stringify(item) %>'
                                                            title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-outline-success view-movements" 
                                                            data-id="<%= item.id %>"
                                                            data-name="<%= item.food_name %>"
                                                            title="Ver movimientos">
                                                        <i class="fas fa-history"></i>
                                                    </button>
                                                    <button class="btn btn-outline-warning adjust-stock" 
                                                            data-id="<%= item.id %>"
                                                            data-name="<%= item.food_name %>"
                                                            data-quantity="<%= item.quantity %>"
                                                            data-unit="<%= item.unit %>"
                                                            title="Ajustar stock">
                                                        <i class="fas fa-exchange-alt"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger delete-item" 
        data-id="<%= item.id %>" 
        data-name="<%= item.food_name %>"
        title="Eliminar">
    <i class="fas fa-trash"></i>
</button>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="11" class="text-center text-muted py-4">
                                                <i class="fas fa-box-open fa-2x mb-3"></i><br>
                                                No hay alimentos en el inventario
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="sticky-footer bg-white mt-4">
            <div class="container my-auto">

            </div>
        </footer>
    </div>

    <!-- Modal para nuevo alimento -->
    <div class="modal fade" id="addInventoryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fas fa-plus me-2"></i>Agregar Nuevo Alimento</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="addInventoryForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Tipo de Alimento *</label>
                                <select class="form-select" id="food_type_id" name="food_type_id" required>
                                    <option value="">Seleccionar tipo</option>
                                    <% if (foodTypes && foodTypes.length > 0) { %>
                                        <% foodTypes.forEach(type => { %>
                                        <option value="<%= type.id %>" data-category="<%= type.category %>" data-unit="<%= type.unit %>">
                                            <%= type.name %> (<%= type.category %> - <%= type.unit %>)
                                        </option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Número de Lote</label>
                                <input type="text" class="form-control" id="lot_number" name="lot_number" 
                                       placeholder="Ej: LOTE-2024-001">
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Cantidad *</label>
                                <input type="number" class="form-control" id="quantity" name="quantity" 
                                       step="0.01" min="0" required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Precio Unitario ($) *</label>
                                <input type="number" class="form-control" id="unit_price" name="unit_price" 
                                       step="0.01" min="0" required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Proveedor</label>
                                <input type="text" class="form-control" id="supplier" name="supplier" 
                                       placeholder="Nombre del proveedor">
                            </div>
