    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Inicializar DataTable
            $('#inventoryTable').DataTable({
                pageLength: 25,
               language: {
    search: "Buscar:",
    lengthMenu: "Mostrar _MENU_ elementos",
    info: "Mostrando _START_ a _END_ de _TOTAL_ entradas",
    paginate: {
        first: "Primero",
        last: "Último",
        next: "Siguiente",
        previous: "Anterior"
    }
},
            });
            
            // Gráfico de distribución por tipo de animal
            const animalValueChart = new Chart(
                document.getElementById('animalValueChart').getContext('2d'),
                {
                    type: 'doughnut',
                    data: {
                        labels: ['Ganado', 'Porcinos', 'Ambos'],
                        datasets: [{
                            data: [
                                <%= stats.cattle_value || 0 %>,
                                <%= stats.pig_value || 0 %>,
                                <%= stats.both_value || 0 %>
                            ],
                            backgroundColor: [
                                '#f6c23e',
                                '#32CD32',
                                '#4e73df'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                }
            );
            
            // Guardar nuevo alimento
            document.getElementById('saveInventoryBtn').addEventListener('click', function() {
                const form = document.getElementById('addInventoryForm');
                const formData = new FormData(form);
                
                // Validaciones
                if (!formData.get('food_type_id') || !formData.get('quantity') || 
                    !formData.get('unit_price') || !formData.get('entry_date')) {
                    alert('Por favor complete todos los campos requeridos (*)');
                    return;
                }
                
                const data = {
                    food_type_id: formData.get('food_type_id'),
                    lot_number: formData.get('lot_number') || null,
                    quantity: parseFloat(formData.get('quantity')),
                    unit_price: parseFloat(formData.get('unit_price')),
                    supplier: formData.get('supplier') || null,
                    entry_date: formData.get('entry_date'),
                    expiration_date: formData.get('expiration_date') || null,
                    storage_location: formData.get('storage_location') || null,
                    animal_type: formData.get('animal_type'),
                    min_stock: parseFloat(formData.get('min_stock')) || 0,
                    max_stock: parseFloat(formData.get('max_stock')) || 0,
                    notes: formData.get('notes') || null
                };
                
                fetch('/inventory/api/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data)
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        alert('Alimento agregado exitosamente');
                        const modal = bootstrap.Modal.getInstance(document.getElementById('addInventoryModal'));
                        modal.hide();
                        location.reload();
                    } else {
                        alert('Error: ' + result.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al guardar el alimento');
                });
            });
            
            // Registrar salida de alimento
            const movementSelect = document.getElementById('movement_inventory_id');
            const quantityInput = document.getElementById('movement_quantity');
            
            movementSelect.addEventListener('change', function() {
                const selectedOption = this.options[this.selectedIndex];
                const available = parseFloat(selectedOption.dataset.quantity);
                const unit = selectedOption.dataset.unit;
                const animalType = selectedOption.dataset.animal;
                
                document.getElementById('availableQuantity').textContent = 
                    `Disponible: ${available} ${unit}`;
                quantityInput.max = available;
                
                // Sugerir tipo de animal basado en el alimento
                const animalSelect = document.getElementById('movement_animal_type');
                if (animalType === 'ganado') {
                    animalSelect.value = 'ganado';
                } else if (animalType === 'porcino') {
                    animalSelect.value = 'porcino';
                }
            });
            
            document.getElementById('saveMovementBtn').addEventListener('click', function() {
                const form = document.getElementById('outMovementForm');
                const formData = new FormData(form);
                
                if (!formData.get('inventory_id') || !formData.get('quantity') || !formData.get('reason')) {
                    alert('Por favor complete los campos requeridos');
                    return;
                }
                
                const data = {
                    inventory_id: formData.get('inventory_id'),
                    quantity: parseFloat(formData.get('quantity')),
                    reason: formData.get('reason'),
                    animal_type: formData.get('animal_type') || null,
                    animal_group: formData.get('animal_group') || null,
                    notes: formData.get('notes') || null
                };
                
                fetch('/inventory/api/movement/out', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data)
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        alert('Salida registrada exitosamente\nNuevo stock: ' + result.new_quantity);
                        const modal = bootstrap.Modal.getInstance(document.getElementById('outMovementModal'));
                        modal.hide();
                        location.reload();
                    } else {
                        alert('Error: ' + result.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al registrar la salida');
                });
            });
            
            // Generar reporte
            document.getElementById('generateReportBtn').addEventListener('click', function() {
                const reportType = document.getElementById('reportType').value;
                const format = document.querySelector('input[name="reportFormat"]:checked').value;
                
                let url = `/inventory/api/report/${format}?type=${reportType}`;
                
                if (format === 'pdf') {
                    // Para PDF, abrir en nueva pestaña
                    window.open(url, '_blank');
                } else {
                    // Para Excel, descargar directamente
                    window.location.href = url;
                }
                
                const modal = bootstrap.Modal.getInstance(document.getElementById('reportModal'));
                modal.hide();
            });
            
            // BOTONES DE ACCIÓN EN LA TABLA - FUNCIONALES
            
            // 1. Botón Editar
            document.querySelectorAll('.edit-item').forEach(button => {
                button.addEventListener('click', function() {
                    const itemData = JSON.parse(this.dataset.item);
                    
                    // Llenar el formulario de edición
                    document.getElementById('edit_id').value = itemData.id;
                    document.getElementById('edit_food_name').value = itemData.food_name || '';
                    document.getElementById('edit_lot_number').value = itemData.lot_number || '';
                    document.getElementById('edit_quantity').value = itemData.quantity || 0;
                    document.getElementById('edit_unit').value = itemData.unit || 'kg';
                    document.getElementById('edit_unit_price').value = itemData.unit_price || 0;
                    document.getElementById('edit_category').value = itemData.category || 'concentrado';
                    document.getElementById('edit_animal_type').value = itemData.animal_type || 'ambos';
                    document.getElementById('edit_min_stock').value = itemData.min_stock || 0;
                    document.getElementById('edit_max_stock').value = itemData.max_stock || 0;
                    document.getElementById('edit_storage_location').value = itemData.storage_location || '';
                    document.getElementById('edit_notes').value = itemData.notes || '';
                    
                    if (itemData.expiration_date) {
                        const expirationDate = new Date(itemData.expiration_date);
                        document.getElementById('edit_expiration_date').value = expirationDate.toISOString().split('T')[0];
                    } else {
                        document.getElementById('edit_expiration_date').value = '';
                    }
                    
                    // Mostrar el modal
                    const editModal = new bootstrap.Modal(document.getElementById('editInventoryModal'));
                    editModal.show();
                });
            });
            
            // 2. Botón Ver Movimientos
            document.querySelectorAll('.view-movements').forEach(button => {
                button.addEventListener('click', function() {
                    const itemId = this.dataset.id;
                    const itemName = this.dataset.name;
                    
                    document.getElementById('movementFoodName').textContent = `Movimientos de: ${itemName}`;
                    
                    // Limpiar tabla anterior
                    document.getElementById('movementsBody').innerHTML = '';
                    document.getElementById('noMovementsMessage').innerHTML = '<p class="text-muted">Cargando movimientos...</p>';
                    
                    // Mostrar modal
                    const movementsModal = new bootstrap.Modal(document.getElementById('movementsModal'));
                    movementsModal.show();
                    
                    // Cargar movimientos desde la API
                    fetch(`/inventory/api/movements/${itemId}`)
                        .then(response => response.json())
                        .then(data => {
                            const movementsBody = document.getElementById('movementsBody');
                            const noMovementsMessage = document.getElementById('noMovementsMessage');
                            
                            if (data.success && data.movements.length > 0) {
                                movementsBody.innerHTML = '';
                                data.movements.forEach(mov => {
                                    const row = document.createElement('tr');
                                    row.innerHTML = `
                                        <td>${new Date(mov.movement_date).toLocaleDateString()}</td>
                                        <td>
                                            <span class="badge bg-${mov.movement_type === 'entrada' ? 'success' : 'warning'}">
                                                ${mov.movement_type === 'entrada' ? 'ENTRADA' : 'SALIDA'}
                                            </span>
                                        </td>
                                        <td class="${mov.movement_type === 'entrada' ? 'text-success' : 'text-danger'}">
                                            ${mov.movement_type === 'entrada' ? '+' : '-'}${mov.quantity} ${mov.unit || 'kg'}
                                        </td>
                                        <td>${mov.responsable || 'Sistema'}</td>
                                        <td>${mov.reason || '-'}</td>
                                    `;
                                    movementsBody.appendChild(row);
                                });
                                noMovementsMessage.style.display = 'none';
                            } else {
                                movementsBody.innerHTML = '';
                                noMovementsMessage.innerHTML = '<p class="text-muted">No hay movimientos registrados para este alimento.</p>';
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            document.getElementById('noMovementsMessage').innerHTML = 
                                '<p class="text-danger">Error al cargar los movimientos.</p>';
                        });
                });
            });
            
            // 3. Botón Ajustar Stock
            document.querySelectorAll('.adjust-stock').forEach(button => {
                button.addEventListener('click', function() {
                    const itemId = this.dataset.id;
                    const itemName = this.dataset.name;
                    const currentQuantity = this.dataset.quantity;
                    const unit = this.dataset.unit;
                    
                    // Llenar el formulario
                    document.getElementById('adjust_id').value = itemId;
                    document.getElementById('adjust_food_name').value = itemName;
                    document.getElementById('adjust_current_stock').value = currentQuantity;
                    document.getElementById('adjust_unit').value = unit;
                    
                    // Mostrar modal
                    const adjustModal = new bootstrap.Modal(document.getElementById('adjustStockModal'));
                    adjustModal.show();
                });
            });
            
            // Guardar edición de alimento
            document.getElementById('updateInventoryBtn').addEventListener('click', function() {
                const form = document.getElementById('editInventoryForm');
                const formData = new FormData(form);
                
                // Validaciones básicas
                if (!formData.get('food_name') || !formData.get('quantity') || !formData.get('unit_price')) {
                    alert('Por favor complete los campos requeridos');
                    return;
                }
                
                const data = {
                    id: formData.get('id'),
                    food_name: formData.get('food_name'),
                    lot_number: formData.get('lot_number') || null,
                    quantity: parseFloat(formData.get('quantity')),
                    unit: formData.get('unit'),
                    unit_price: parseFloat(formData.get('unit_price')),
                    expiration_date: formData.get('expiration_date') || null,
                    category: formData.get('category'),
                    storage_location: formData.get('storage_location') || null,
                    animal_type: formData.get('animal_type'),
                    min_stock: parseFloat(formData.get('min_stock')) || 0,
                    max_stock: parseFloat(formData.get('max_stock')) || 0,
                    notes: formData.get('notes') || null
                };
                
                fetch('/inventory/api/update', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data)
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        alert('Alimento actualizado exitosamente');
                        const modal = bootstrap.Modal.getInstance(document.getElementById('editInventoryModal'));
                        modal.hide();
                        location.reload();
                    } else {
                        alert('Error: ' + result.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al actualizar el alimento');
                });
            });
            
            // Aplicar ajuste de stock
            document.getElementById('saveAdjustmentBtn').addEventListener('click', function() {
                const form = document.getElementById('adjustStockForm');
                const formData = new FormData(form);
                
                if (!formData.get('adjust_type') || !formData.get('quantity') || !formData.get('reason')) {
                    alert('Por favor complete todos los campos requeridos');
                    return;
                }
                
                const data = {
                    inventory_id: formData.get('id'),
                    adjust_type: formData.get('adjust_type'),
                    quantity: parseFloat(formData.get('quantity')),
                    reason: formData.get('reason'),
                    details: formData.get('details') || null
                };
                
                fetch('/inventory/api/adjust', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data)
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        alert('Stock ajustado exitosamente\nNuevo stock: ' + result.new_quantity);
                        const modal = bootstrap.Modal.getInstance(document.getElementById('adjustStockModal'));
                        modal.hide();
                        location.reload();
                    } else {
                        alert('Error: ' + result.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al ajustar el stock');
                });
            });
            
            // Auto-calcular precio total cuando cambia cantidad o precio unitario
            const quantityInputs = document.querySelectorAll('input[name="quantity"], input[name="unit_price"]');
            quantityInputs.forEach(input => {
                input.addEventListener('input', function() {
                    const form = this.closest('form');
                    if (form) {
                        const quantity = parseFloat(form.querySelector('input[name="quantity"]')?.value) || 0;
                        const unitPrice = parseFloat(form.querySelector('input[name="unit_price"]')?.value) || 0;
                        const totalValue = quantity * unitPrice;
                        
                        // Buscar y actualizar campo de valor total si existe
                        const totalField = form.querySelector('input[name="total_value"]');
                        if (totalField) {
                            totalField.value = totalValue.toFixed(2);
                        }
                    }
                });
            });
            // Lógica para eliminar alimento
document.querySelectorAll('.delete-item').forEach(button => {
    button.addEventListener('click', function() {
        const id = this.dataset.id;
        const name = this.dataset.name;
        
        if (confirm(`¿Estás segura de eliminar "${name}"? Esta acción no se puede deshacer.`)) {
            fetch(`/inventory/api/delete/${id}`, {
                method: 'DELETE'
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    alert(result.message);
                    location.reload();
                } else {
                    
                    alert('Error: ' + result.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error al intentar eliminar');
            });
        }
    });
});
        });

    </script>
</body>
</html>
